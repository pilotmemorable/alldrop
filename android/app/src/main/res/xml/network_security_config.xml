<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      The web UI is served by the app's own engine on 127.0.0.1, which must be
      reachable over plain HTTP. Everything else (device-to-device transfers) is
      TLS, so cleartext is restricted to loopback only. On API 24+ this config
      governs and denies all other cleartext; API 21-23 fall back to the
      android:usesCleartextTraffic flag in the manifest.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
